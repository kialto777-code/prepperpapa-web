<script id="fej2js">
(function(){var n=document.querySelector('header .nav.fej2');if(!n)return;
  var h=n.querySelector('.hamb'), mq=window.matchMedia('(max-width:920px)');
  // the row only where it fits; otherwise (and always on phones) the hamburger
  function fit(){n.classList.remove('kompakt');
    if(mq.matches||n.scrollWidth>n.clientWidth+1)n.classList.add('kompakt');
    if(!n.classList.contains('kompakt'))zar();}
  function zar(){n.classList.remove('nyitva');if(h)h.setAttribute('aria-expanded','false');}
  if(h)h.addEventListener('click',function(e){e.stopPropagation();var o=n.classList.toggle('nyitva');h.setAttribute('aria-expanded',o?'true':'false');});
  document.addEventListener('click',function(e){if(!n.contains(e.target))zar();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')zar();});
  n.querySelectorAll('.linkek a').forEach(function(a){a.addEventListener('click',zar);});
  fit();window.addEventListener('resize',fit);
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fit);})();
</script>
